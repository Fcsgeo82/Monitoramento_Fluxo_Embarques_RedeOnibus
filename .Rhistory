nome_base <- "escala_veiculos_Rede_jun2026_DU"
caminho_rds <- file.path(caminho_diretorio, paste0(nome_base, ".rds"))
source("C:/github_repositories/Compilacao_Dados_Frota_Partidas/Compilacao_Frota_Partidas.R")
escala_final |> head(3)
escala_final |> str()
library(dplyr)
library(tidyr)
library(data.table)
resultado <- escala_final |>
mutate(hora = as.integer(format(datetime_partida, "%H"))) |>
filter(hora >= 6 & hora < 18) |>
mutate(periodo = if_else(hora < 12, "06_12", "12_18")) |>
# Veículos únicos por linha, dia e período
summarise(
veiculos_unicos = n_distinct(id_veiculo),
.by = c(data, linha, periodo)
) |>
# Média pelo número de dias de cada período
summarise(
media_veiculos = mean(veiculos_unicos),
n_dias = n_distinct(data),
.by = c(linha, periodo)
) |>
pivot_wider(
names_from = periodo,
values_from = c(media_veiculos, n_dias),
names_glue = "{periodo}_{.value}"
) |>
arrange(linha)
resultado |> head(10)
nrow(resultado)
caminho_saida <- file.path(caminho_diretorio, "media_veiculos_por_linha_periodo_jun2026.csv")
data.table::fwrite(resultado, caminho_saida, sep = ";", dec = ",", bom = TRUE)
message("✅ CSV salvo em: ", caminho_saida)
